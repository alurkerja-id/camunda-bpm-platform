  <artifactId>camunda-coverage-report</artifactId>
  <packaging>pom</packaging>
  <name>Camunda Platform - Coverage Report</name>

  <description>
    Alurkerja fork: one JaCoCo report covering the whole reactor.

    A per-module report only maps the classes in that module's own target/classes, so a class that
    is only ever executed by another module's tests reads as 0% - camunda-juel, for one, has no
    tests of its own but is exercised heavily by the engine suite. jacoco:report-aggregate merges
    the execution data of every module listed below and reports it against all of their classes,
    which puts that coverage back where it belongs.

    This module depends on every module it should cover and therefore builds last, when all the
    jacoco.exec files exist. Nothing is published from here; it only produces
    target/site/jacoco-aggregate/jacoco.xml, which SonarQube reads (see parent/pom.xml, property
    sonar.coverage.jacoco.xmlReportPaths).
  </description>

  <properties>
    <!-- no sources of its own; the aggregate report is what this module exists for -->
    <sonar.skip>true</sonar.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

